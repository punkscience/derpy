{"nodes": [{"id": "readme_derpy_project", "label": "derpy (terminal music player)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal music player with opinion: shuffle everything, earmark what's hitting right, let the list expire. Minimal TUI, Nostr integration, Blossom uploads, cross-platform."}, {"id": "readme_blossom_setup", "label": "Blossom Server Management", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "derpy encrypts audio (AES-256-GCM) and uploads to Blossom servers in 16 MB chunks. Default servers: blossom.band, cdn.satellite.earth, nostr.build. Kind-10063 auto-discovery supported."}, {"id": "readme_nostr_setup", "label": "Nostr Key Setup", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires Nostr private key (nsec1... or raw hex). Earmarks are NIP-44 encrypted. Key stored via 'derpy nostr-key' or prompted inline on first use."}, {"id": "readme_relay_setup", "label": "Relay Management", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults: relay.damus.io, nos.lol, relay.primal.net, nostr.wine. Commands: list, add, remove, reset."}, {"id": "readme_apt_install", "label": "APT Installation (Debian/Ubuntu)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPG-signed APT repository hosted on GitHub Pages at punkscience.github.io/derpy/apt/. Supports amd64 and arm64."}, {"id": "readme_homebrew_install", "label": "Homebrew Installation (macOS)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "brew install punkscience/homebrew-derpy/derpy. Supports Intel and Apple Silicon."}, {"id": "readme_chocolatey_install", "label": "Chocolatey Installation (Windows)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "choco install derpy (submitted, pending moderation)."}, {"id": "readme_earmark_expiry_purge", "label": "Earmark Auto-Purge", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earmarks older than 30 days are automatically purged on startup, along with their uploaded audio chunks. Enforces the 'let the list expire' philosophy."}, {"id": "readme_encryption_model", "label": "AES-256-GCM Chunk Encryption", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio files encrypted with AES-256-GCM before Blossom upload in 16 MB chunks. Key stored in encrypted NIP-51 earmark payload."}], "edges": [{"source": "readme_derpy_project", "target": "context_track", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_derpy_project", "target": "context_earmark", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_earmark_expiry_purge", "target": "context_earmark", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "read