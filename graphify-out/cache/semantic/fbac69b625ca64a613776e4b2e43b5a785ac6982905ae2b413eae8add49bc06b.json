{"nodes": [{"id": "adr_0001_tags_external_index_external_tag_index", "label": "External Tag Index (ADR-0001)", "file_type": "document", "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tags live in two derpy-owned JSON files under ~/.config/derpy/: tags.json (Sum->[Tag,...]) and sum-cache.json (path->Sum with mtime+size validation). Keyed by dhowden/tag's Sum fingerprint (SHA-1 of audio data, skipping metadata blocks). This survives renames and embedded-metadata edits but not re-encoding."}, {"id": "adr_0001_tags_external_index_tag_sum_fingerprint", "label": "tag.Sum Audio Fingerprint", "file_type": "concept", "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHA-1 of audio data alone, with embedded metadata (ID3v2, ID3v1, MP4 atoms, FLAC blocks) explicitly skipped per-format. Survives renames, moves, and metadata edits but not re-encoding."}, {"id": "adr_0001_tags_external_index_alternative_infile", "label": "In-File Metadata Alternative (rejected)", "file_type": "rationale", "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing tags into ID3v2/Vorbis Comments was rejected because it forces format-specific writer dependencies, restricts to MP3+FLAC, introduces write-during-playback complication, and risks corrupting source files. The interoperability gain isn't a requirement."}, {"id": "adr_0001_tags_external_index_alternative_chromaprint", "label": "Chromaprint/AcoustID Alternative (rejected)", "file_type": "rationale", "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires external fpcalc binary and adds significant complexity. The re-encoding case isn't a real user need for V1."}], "edges": [{"source": "adr_0001_tags_external_index_external_tag_index", "target": "context_tag", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_external_tag_index", "target": "context_sum", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_external_tag_index", "target": "context_tag_index", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_external_tag_index", "target": "context_sum_cache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_tag_sum_fingerprint", "target": "context_sum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_alternative_infile", "target": "context_tag", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}, {"source": "adr_0001_tags_external_index_alternative_chromaprint", "target": "context_sum", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-tags-external-index.md", "source_location": null, "weight": 1.0}], "hy